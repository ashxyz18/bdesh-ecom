  "entryPoint": "index.html",
  "sections": {},
  "interactivity": {
    "cart": {
      "trigger": ".header-icon[href=\"#cart\"]",
      "drawer": ".cart-drawer",
      "overlay": ".cart-overlay"
    },
    "search": {
      "trigger": ".search-btn",
      "overlay": ".search-overlay",
      "input": "#searchInput"
    },
    "mobileMenu": {
      "trigger": ".menu-btn",
      "menu": ".mobile-menu",
      "overlay": ".menu-overlay",
      "closeBtn": ".close-menu"
    },
    "wishlist": {
      "selector": ".wishlist-btn",
      "activeClass": "active"
    },
    "productCards": {
      "quickAdd": ".quick-add",
      "wishlist": ".wishlist-btn",
      "productLink": ".product-card"
    },
    "newsletter": {
      "form": ".newsletter-form",
      "input": "input[type=\"email\"]",
      "button": "button[type=\"submit\"]"
    }
  },
  "configSchema": {
    "brand": {
      "label": "Store Brand",
      "fields": {
        "storeName": {
          "type": "text",
          "label": "Store name"
        },
        "logo": {
          "type": "image",
          "label": "Logo"
        }
      }
    },
    "hero": {
      "title": "Hero Banner",
      "description": "Configure the main homepage hero section",
      "fields": [
        {
          "id": "heroImage",
          "name": "Hero Image URL",
          "type": "image",
          "description": "Main hero background image"
        },
        {
          "id": "heroMobileImage",
          "name": "Hero Mobile Image URL",
          "type": "image",
          "description": "Hero image for mobile devices"
        },
        {
          "id": "heroTitle",
          "name": "Hero Title",
          "type": "text",
          "default": "Days of Summer",
          "description": "Main headline text"
        },
        {
          "id": "heroSubtitle",
          "name": "Hero Subtitle",
          "type": "textarea",
          "default": "Lightness and texture blend in a natural balance, capturing the energy of the summer season.",
          "description": "Subheading or description text"
        },
        {
          "id": "heroCtaText",
          "name": "CTA Button Text",
          "type": "text",
          "default": "Discover",
          "description": "Call-to-action button label"
        },
        {
          "id": "heroCtaLink",
          "name": "CTA Link",
          "type": "text",
          "default": "/collection/summer-collection",
          "description": "URL for the CTA button"
        },
        {
          "id": "heroTextPosition",
          "name": "Text Position",
          "type": "select",
          "default": "center",
          "options": [
            "left",
            "center",
            "right",
            "bottom-left",
            "bottom-right"
          ],
          "description": "Position of text overlay on hero"
        },
        {
          "id": "heroTextColor",
          "name": "Text Color",
          "type": "color",
          "default": "#FFFFFF",
          "description": "Color of hero text"
        },
        {
          "id": "heroOverlayOpacity",
          "name": "Overlay Opacity",
          "type": "range",
          "default": 0.2,
          "min": 0,
          "max": 1,
          "step": 0.1,
          "description": "Dark overlay opacity on hero image"
        },
        {
          "id": "heroEnabled",
          "name": "Show Hero Banner",
          "type": "boolean",
          "default": true,
          "description": "Toggle hero banner visibility"
        }
      ]
    },
    "theme": {
      "title": "Theme Settings",
      "description": "Customize the visual identity of your store",
      "fields": [
        {
          "id": "primaryColor",
          "name": "Primary Color",
          "type": "color",
          "default": "#000000",
          "description": "Main brand color used for text and borders"
        },
        {
          "id": "secondaryColor",
          "name": "Secondary Color",
          "type": "color",
          "default": "#FFFFFF",
          "description": "Background color and contrast elements"
        },
        {
          "id": "accentColor",
          "name": "Accent Color",
          "type": "color",
          "default": "#CC0000",
          "description": "Highlight color for CTAs and badges"
        },
        {
          "id": "mutedColor",
          "name": "Muted Text Color",
          "type": "color",
          "default": "#666666",
          "description": "Secondary text and subtle elements"
        },
        {
          "id": "fontFamilyHeading",
          "name": "Heading Font",
          "type": "select",
          "default": "'Helvetica Neue', Arial, sans-serif",
          "options": [
            "'Helvetica Neue', Arial, sans-serif",
            "'Times New Roman', serif",
            "'Georgia', serif",
            "'Montserrat', sans-serif",
            "'Playfair Display', serif"
          ],
          "description": "Font for headings and display text"
        },
        {
          "id": "fontFamilyBody",
          "name": "Body Font",
          "type": "select",
          "default": "'Helvetica Neue', Arial, sans-serif",
          "options": [
            "'Helvetica Neue', Arial, sans-serif",
            "'Times New Roman', serif",
            "'Georgia', serif",
            "'Montserrat', sans-serif",
            "'Inter', sans-serif"
          ],
          "description": "Font for body text and UI elements"
        }
      ]
    },
    "announcementBar": {
      "title": "Announcement Bar",
      "description": "Top promotional banner",
      "fields": [
        {
          "id": "announcementText",
          "name": "Announcement Text",
          "type": "text",
          "default": "Complimentary shipping on all orders",
          "description": "Text displayed in the announcement bar"
        },
        {
          "id": "announcementLink",
          "name": "Announcement Link",
          "type": "text",
          "description": "Optional link for the announcement"
        },
        {
          "id": "announcementEnabled",
          "name": "Show Announcement",
          "type": "boolean",
          "default": true,
          "description": "Toggle announcement bar visibility"
        }
      ]
    },
    "navigation": {
      "title": "Navigation",
      "description": "Configure main navigation structure",
      "fields": [
        {
          "id": "navLinks",
          "name": "Navigation Links",
          "type": "repeater",
          "description": "Main navigation menu items",
          "fields": [
            {
              "id": "label",
              "name": "Label",
              "type": "text"
            },
            {
              "id": "url",
              "name": "URL",
              "type": "text"
            },
            {
              "id": "children",
              "name": "Submenu Items",
              "type": "repeater",
              "fields": [
                {
                  "id": "label",
                  "name": "Label",
                  "type": "text"
                },
                {
                  "id": "url",
                  "name": "URL",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "title": "Footer",
      "description": "Configure footer content",
      "fields": [
        {
          "id": "footerNewsletterTitle",
          "name": "Newsletter Title",
          "type": "text",
          "default": "Stay Connected",
          "description": "Newsletter section heading"
        },
        {
          "id": "footerNewsletterText",
          "name": "Newsletter Description",
          "type": "textarea",
          "default": "Subscribe to receive updates on new collections and exclusive offers.",
          "description": "Newsletter section description"
        },
        {
          "id": "footerShowSocial",
          "name": "Show Social Links",
          "type": "boolean",
          "default": true,
          "description": "Display social media links"
        },
        {
          "id": "footerCopyright",
          "name": "Copyright Text",
          "type": "text",
          "default": "© 2026 All Rights Reserved",
          "description": "Footer copyright text"
        }
      ]
    },
    "productGrid": {
      "title": "Product Grid",
      "description": "Configure product listing layout",
      "fields": [
        {
          "id": "productsPerPage",
          "name": "Products Per Page",
          "type": "number",
          "default": 24,
          "min": 8,
          "max": 48,
          "description": "Number of products per page"
        },
        {
          "id": "productCardAspectRatio",
          "name": "Image Aspect Ratio",
          "type": "select",
          "default": "3/4",
          "options": [
            "1/1",
            "3/4",
            "4/5",
            "16/9"
          ],
          "description": "Aspect ratio for product images"
        },
        {
          "id": "showQuickAdd",
          "name": "Show Quick Add Button",
          "type": "boolean",
          "default": true,
          "description": "Display quick add to cart on hover"
        }
      ]
    }
  },
