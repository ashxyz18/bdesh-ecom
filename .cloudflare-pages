# Cloudflare Pages Build Configuration for Next.js
# This configuration is read by Cloudflare Pages during build and deployment

[build]
# Build command executed by Cloudflare Pages
command = "npm run build:cloudflare"
# Working directory for the build command
cwd = "."
# Static assets output directory
publish_dir = "frontend/web/.next"

# Environment variables for production
[env.production]
vars = { NODE_ENV = "production", ENVIRONMENT = "production", NEXT_TELEMETRY_DISABLED = "1" }

# Environment variables for preview/staging
[env.preview]
vars = { NODE_ENV = "production", ENVIRONMENT = "preview", NEXT_TELEMETRY_DISABLED = "1" }

# Caching rules for static assets
[[routes]]
pattern = "*.{jpg,jpeg,png,gif,ico,svg,webp,avif,woff,woff2,ttf,eot}"
status = 200
cache_on_cookie = ""
cache_default_ttl = 31536000
cache_key_query_string_whitelist = ""
cache_key_query_string_ignore = "*"
cache_key_extra_on_cookie = ""
cache_key_extra_on_host = true
cache_key_extra_on_proto = true
cache_key_extra_on_query_string = ""

# JavaScript and CSS files
[[routes]]
pattern = "*.{js,css}"
status = 200
cache_on_cookie = ""
cache_default_ttl = 31536000
cache_key_query_string_whitelist = ""
cache_key_query_string_ignore = "*"
cache_key_extra_on_cookie = ""
cache_key_extra_on_host = true
cache_key_extra_on_proto = true
cache_key_extra_on_query_string = ""

# API routes - no caching
[[routes]]
pattern = "/api/*"
status = 200
cache_on_cookie = ""
cache_default_ttl = 0
cache_key_query_string_whitelist = "*"
