# Database (Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/bdesh_ecom"
DIRECT_URL="postgresql://postgres:password@localhost:5432/bdesh_ecom"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# Next.js
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_TELEMETRY_DISABLED="1"

# Authentication
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="your-jwt-secret-here"

# AI Services (at least one required)
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
GOOGLE_API_KEY=""
GROQ_API_KEY=""

# Payment Gateways
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
NAGAD_MERCHANT_ID=""
NAGAD_PUBLIC_KEY=""
NAGAD_PRIVATE_KEY=""

# Email Service
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@bdesh.shop"

# Redis (optional, for caching)
REDIS_URL=""

# Stripe (optional)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Cloudflare Configuration (for Cloudflare Pages deployment)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_PROJECT_NAME="bdesh-ecommerce"
CLOUDFLARE_ZONE_ID=""

# Cloudflare Workers KV (optional, for edge caching)
CLOUDFLARE_KV_BINDING="KV_CACHE"

# Cloudflare R2 (optional, for asset storage)
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""

# Cloudflare Email Routing (optional)
CLOUDFLARE_EMAIL_ROUTING_ENABLED="false"

# Deployment Environment
DEPLOYMENT_ENV="development"
DEPLOYMENT_PLATFORM="cloudflare-pages"
