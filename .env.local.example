# OpenAI API Key (Project-based key - sk-proj-...)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# OpenRouter API Key (Alternative - has free models)
# Get your key from: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...

# Recommended models for cost-efficiency:
# - gpt-4o-mini: $0.15/$0.60 per 1M tokens (best value)
# - gpt-4o: $2.50/$10.00 per 1M tokens (highest quality)
#
# OpenRouter free models:
# - google/gemini-flash-2.0:free
# - meta-llama/llama-3.3-70b-instruct:free

# Other environment variables (existing)
DATABASE_URL=...
NEXTAUTH_SECRET=...
NEXTAUTH_URL=...
