{
  "name": "bdesh-ecommerce",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:cloudflare": "turbo run build --filter=!@bdesh/web && cd frontend/web && npx @cloudflare/next-on-pages",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "start": "cd frontend/web && npx next start -p $PORT",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.3.0",
    "jest-environment-node": "^30.3.0",
    "ts-jest": "^29.4.9",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3"
  },
  "workspaces": [
    "frontend/*",
    "backend/*",
    "packages/*"
  ],
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "firebase": "^12.12.1"
  }
}
